#!/usr/bin/env bash
#
# metabob-mcp pre-push hook — branch policy guard.
#
# Enforces the repo's two-branch model and its release order:
#
#   * dev  — the default/integration branch. All development lands here
#            (via PRs). This is where day-to-day work goes.
#   * main — release branch. Plugin marketplaces clone it, and its bundles
#            launch the exact version they pin, so main moves only after npm
#            has that version: the release workflow
#            (.github/workflows/release.yml) publishes a tagged release commit,
#            then fast-forwards main to it.
#
# So a push that adds commits to main is refused, and a push of a v<version>
# tag is allowed only when the tag matches the tagged commit's package.json
# version and the commit is already on origin/dev.
#
# Pushes to any other branch (dev, feature branches) are unaffected.
#
# Emergency bypass:  METABOB_ALLOW_MAIN_PUSH=1 git push ...
# Blunt bypass:      git push --no-verify   (use sparingly)
#
# git invokes this as:  pre-push <remote-name> <remote-url>
# with one line per ref on stdin:  <local_ref> <local_sha> <remote_ref> <remote_sha>

set -euo pipefail

RED=$'\033[0;31m'
YELLOW=$'\033[1;33m'
GREEN=$'\033[0;32m'
NC=$'\033[0m'

ZERO="0000000000000000000000000000000000000000"

fail() {
  echo "${RED}✗ pre-push: $1${NC}" >&2
  echo "" >&2
  echo "${YELLOW}main is the release branch: the release workflow fast-forwards it to a release commit once that${NC}" >&2
  echo "${YELLOW}version is on npm. Land work on dev; to release, tag the release commit on dev:${NC}" >&2
  echo "    git push origin HEAD:dev            # or open a PR into dev" >&2
  echo "    git tag v<version> <commit> && git push origin v<version>" >&2
  echo "" >&2
  echo "Emergency override:  METABOB_ALLOW_MAIN_PUSH=1 git push ..." >&2
  exit 1
}

tag_fail() {
  echo "${RED}✗ pre-push: $1${NC}" >&2
  echo "" >&2
  echo "${YELLOW}A v<version> tag starts the release workflow (.github/workflows/release.yml), which publishes${NC}" >&2
  echo "${YELLOW}that version to npm. Tag the release commit on dev whose package.json has that version.${NC}" >&2
  echo "Emergency override:  METABOB_ALLOW_MAIN_PUSH=1 git push ..." >&2
  exit 1
}

while read -r local_ref local_sha remote_ref remote_sha; do
  # A release tag: it publishes its commit, so the commit must be a release checkpoint on dev.
  case "$remote_ref" in
    refs/tags/v*)
      [ "$local_sha" = "$ZERO" ] && continue
      [ "${METABOB_ALLOW_MAIN_PUSH:-}" = "1" ] && continue
      tag="${remote_ref#refs/tags/}"
      commit="$(git rev-parse "${local_sha}^{commit}")"
      version="$(git show "${commit}:package.json" 2>/dev/null | grep -o '"version"[[:space:]]*:[[:space:]]*"[^"]*"' | head -1 | sed 's/.*"\([^"]*\)"$/\1/')"
      [ "$tag" = "v${version}" ] || tag_fail "tag ${tag} names a commit whose package.json version is ${version:-missing}."
      if git rev-parse --verify --quiet origin/dev >/dev/null; then
        git merge-base --is-ancestor "$commit" origin/dev \
          || tag_fail "tag ${tag} names $(git rev-parse --short "$commit"), which is not on dev. Push the release commit to dev first."
      else
        echo "${YELLOW}pre-push: origin/dev not found locally (fetch it) — skipping the 'on dev' check for ${tag}.${NC}" >&2
      fi
      echo "${GREEN}pre-push: ${tag} names a release commit on dev; the release workflow publishes it, then moves main.${NC}" >&2
      continue
      ;;
  esac

  # Otherwise, only police pushes that update main.
  case "$remote_ref" in
    refs/heads/main|refs/heads/master) ;;
    *) continue ;;
  esac

  # Deleting the branch — not our concern.
  [ "$local_sha" = "$ZERO" ] && continue

  if [ "${METABOB_ALLOW_MAIN_PUSH:-}" = "1" ]; then
    echo "${YELLOW}pre-push: METABOB_ALLOW_MAIN_PUSH=1 — skipping main branch policy.${NC}" >&2
    continue
  fi

  # Nothing new (main already contains this commit) — allow.
  if [ "$remote_sha" != "$ZERO" ] && git merge-base --is-ancestor "$local_sha" "$remote_sha" 2>/dev/null; then
    continue
  fi

  fail "main moves only by the release workflow, after npm has the version main's bundles pin."
done

exit 0
