#!/usr/bin/env bash
#
# metabob-mcp pre-commit hook.
#
# Mirrors the metabob-devbob super-repo hook with mcp-specific allowlists.
# Runs three layers in order:
#
#   0. Doc links — scripts/doclinks.mjs precommit lists live docs linked to
#      what is staged but not in the commit, and broken citations. WARNS
#      ONLY: the gate that fails on broken citations is tests/unit/doclinks.test.ts.
#   1. Placement check — rejects newly-added or renamed-into entries that
#      violate the placement rules (only ADDED files are checked; modifying
#      existing tracked files is never blocked).
#   2. Secrets scan — gitleaks protect --staged, on every commit (modify-only
#      commits included).
#
# Bypass: `git commit --no-verify` (use sparingly).
#
# Layout this hook expects:
#   src/         — MCP server source (cli.ts, index.ts, tool handlers)
#   tests/       — test suites
#   docs/        — stateless reference (DEPLOYMENT.md, PUBLISHING.md, QUICK_START.md, ...)
#   scripts/     — operational scripts (incl. scripts/git-hooks/)
#   openspec/    — change proposals
#   packages/    — internal sub-packages (if any)
#   lab/         — the two-node substrate lab (lab/lab.sh) for live testing
#   .claude/     — shared Claude Code project settings (settings.json and its hooks)

set -euo pipefail

REPO_ROOT="$(git rev-parse --show-toplevel)"
cd "$REPO_ROOT"

RED=$'\033[0;31m'
YELLOW=$'\033[1;33m'
GREEN=$'\033[0;32m'
DIM=$'\033[2m'
NC=$'\033[0m'

ROOT_ALLOWLIST=(
  CLAUDE.md
  README.md
  CHANGELOG.md
  LICENSE
  LICENSE.md
  .gitignore
  .gitattributes
  .editorconfig
  .nvmrc
  .tool-versions
  .prettierrc
  .prettierrc.json
  .prettierrc.yaml
  .prettierignore
  .eslintrc.js
  .eslintrc.json
  .eslintignore
  .npmignore
  .dockerignore
  .env.example
  .gitleaks.toml
  package.json
  bun.lock
  bunfig.toml
  package-lock.json
  yarn.lock
  pnpm-lock.yaml
  tsconfig.json
  tsconfig.build.json
  vitest.config.ts
  jest.config.ts
  jest.config.js
  biome.json
  Dockerfile
)

ALLOWED_TOPLEVEL_DIRS=(
  src
  lab
  test
  tests
  scripts
  docs
  openspec
  packages
  .github
  .minibob
  # Shared Claude Code project settings — .claude/settings.json wires the
  # doclinks hooks. Machine-local files under it (settings.local.json,
  # worktrees/) are gitignored.
  .claude
)

ARTEFACT_EXTENSIONS='png|jpg|jpeg|gif|webp|svg|bmp|ico|mp4|mov|webm|pdf|zip|tar|gz|tgz'

# Doc links — warn-only, and run for every commit (modified files included),
# ahead of the added-files gate below. Never blocks: a failure of the script
# itself is ignored, and a missing node skips it.
if command -v node >/dev/null 2>&1; then
  node "$REPO_ROOT/scripts/doclinks.mjs" precommit || true
fi

# Placement applies to added/renamed entries only; an empty list skips it but
# never skips the secrets scan below, which covers every staged change.
mapfile -t STAGED < <(git diff --cached --name-only --diff-filter=AR)

violations=()

is_root_allowlisted() {
  local name="$1"
  for entry in "${ROOT_ALLOWLIST[@]}"; do
    [[ "$name" == "$entry" ]] && return 0
  done
  [[ "$name" == .env.*.example || "$name" == .env.example ]] && return 0
  [[ "$name" == tsconfig.*.json ]] && return 0
  [[ "$name" == Dockerfile.* ]] && return 0
  return 1
}

is_under_allowed_toplevel() {
  local path="$1"
  local first="${path%%/*}"
  for dir in "${ALLOWED_TOPLEVEL_DIRS[@]}"; do
    [[ "$first" == "$dir" ]] && return 0
  done
  return 1
}

flag() {
  local file="$1" reason="$2" remedy="$3"
  violations+=("${file}|${reason}|${remedy}")
}

for file in "${STAGED[@]}"; do
  base="$(basename "$file")"
  ext="${base##*.}"
  ext_lower="${ext,,}"

  if [[ "$file" == */* ]]; then
    if ! is_under_allowed_toplevel "$file"; then
      flag "$file" \
        "new file in unrecognised top-level directory" \
        "move under src/, tests/, scripts/, docs/, openspec/, or packages/"
      continue
    fi
  else
    if ! is_root_allowlisted "$base"; then
      case "$base" in
        *.md)
          flag "$file" \
            "new markdown file at metabob-mcp root" \
            "stateless reference docs go in docs/ (DEPLOYMENT.md, PUBLISHING.md, QUICK_START.md already live there); one-off writeups go in commit messages, not the tree"
          ;;
        *.sh|*.ts|*.tsx|*.js|*.mjs|*.cjs|*.py)
          flag "$file" \
            "new script at metabob-mcp root" \
            "operational scripts go in scripts/; source goes in src/; ad-hoc test-*.{ts,sh} / demo-*.sh / show-*.sh at root are session artefacts and belong in commit history"
          ;;
        test-*|*-test.*|*.test.*|tests-*|demo-*|show-*)
          flag "$file" \
            "new test/demo file at metabob-mcp root" \
            "tests live in tests/; runnable demos in scripts/; one-off scripts go into the commit that needed them"
          ;;
        *.yaml|*.yml)
          flag "$file" \
            "new yaml file at metabob-mcp root" \
            "config goes alongside what it configures (src/, tests/); CI in .github/workflows/"
          ;;
        *.html|*.txt|*.json|*.toml|*.surql|*.sql|*.jsonl)
          flag "$file" \
            "new data/config file at metabob-mcp root" \
            "move under the owning area (src/, scripts/, docs/) — the root holds project metadata only"
          ;;
        *)
          if [[ "$ext_lower" =~ ^($ARTEFACT_EXTENSIONS)$ ]]; then
            flag "$file" \
              "new binary/artefact at metabob-mcp root" \
              "binary assets go in docs/assets/<topic>/; build outputs and screenshots should be gitignored"
          else
            flag "$file" \
              "new file at metabob-mcp root not in allowlist" \
              "extend ROOT_ALLOWLIST in scripts/git-hooks/pre-commit only if the file is genuinely repo-wide metadata"
          fi
          ;;
      esac
      continue
    fi
  fi

  if [[ "$ext_lower" =~ ^($ARTEFACT_EXTENSIONS)$ ]]; then
    if [[ "$file" != docs/assets/* && "$file" != docs/*/assets/* ]]; then
      flag "$file" \
        "binary/artefact outside docs/assets/" \
        "screenshots are session artefacts (gitignore them); illustrative assets go in docs/assets/<topic>/"
    fi
  fi

  if [[ "$base" =~ ^test- || "$base" =~ -test\. || "$base" =~ \.test\. || "$base" =~ ^tests- ]]; then
    if [[ "$file" != test/* && "$file" != tests/* && "$file" != src/* && "$file" != packages/*/test/* && "$file" != packages/*/tests/* ]]; then
      flag "$file" \
        "test file outside a recognised test suite" \
        "tests go under tests/ or co-located with src/<module>/__tests__/"
    fi
  fi
done

if [[ ${#violations[@]} -gt 0 ]]; then
  printf '%s\n' "${RED}━━━ metabob-mcp placement check failed ━━━${NC}"
  printf '%s\n\n' "${DIM}rules: scripts/git-hooks/README.md${NC}"

  for v in "${violations[@]}"; do
    IFS='|' read -r file reason remedy <<<"$v"
    printf '  %s%s%s\n' "${YELLOW}✗${NC} " "$file" ""
    printf '      %sreason:%s %s\n' "$DIM" "$NC" "$reason"
    printf '      %sfix:   %s %s\n\n' "$DIM" "$NC" "$remedy"
  done

  cat <<EOF
${DIM}Why this exists${NC}
  metabob-mcp is an MCP server distributed via npm. The repo is organised
  around src/ (server source — cli.ts, index.ts, tool handlers), tests/
  (test suites), docs/ (stateless reference: DEPLOYMENT, PUBLISHING,
  QUICK_START), scripts/ (operational tooling), openspec/ (change
  proposals), and a small set of project-metadata files at root. Ad-hoc
  test-*.{ts,sh} / demo-*.sh / show-*.sh dumps at root accumulate as cruft
  — put them in the commit message that introduced the change instead.

${DIM}Common moves${NC}
  Stateless reference doc          ->  docs/<topic>.md
  One-off helper script            ->  scripts/<verb>-<noun>.sh
  Test (unit / integration)        ->  tests/<...>
  Screenshots / playwright output  ->  add the directory to .gitignore

${DIM}Bypass${NC}
  git commit --no-verify   ${DIM}(use sparingly; the rules exist to keep blame readable)${NC}
EOF

  exit 1
fi

if command -v gitleaks >/dev/null 2>&1; then
  if ! gitleaks protect --staged --redact --no-banner 2>&1; then
    printf '\n%s\n' "${RED}━━━ gitleaks: secrets detected in staged diff ━━━${NC}"
    cat <<EOF
${DIM}What to do${NC}
  1. Remove the secret from the file before committing.
  2. Rotate the leaked credential immediately — assume it is compromised
     once it has touched the staging tree.
  3. If gitleaks is flagging a false positive, add an inline allowlist
     comment ${DIM}some-value  # gitleaks:allow${NC} or extend the ruleset
     in .gitleaks.toml.

${DIM}Bypass${NC}
  git commit --no-verify   ${DIM}(only after rotating the credential)${NC}
EOF
    exit 1
  fi
else
  printf '%s\n' "${YELLOW}note:${NC} gitleaks is not installed; secrets scan was skipped."
  printf '%s\n' "      install: ${DIM}brew install gitleaks${NC} | ${DIM}go install github.com/gitleaks/gitleaks/v8@latest${NC} | ${DIM}https://github.com/gitleaks/gitleaks/releases${NC}"
fi

exit 0
