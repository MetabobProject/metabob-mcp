# The agent cell: one task from the ledger, worked by a headless harness with the MCP, in a container that holds no
# git credential and mounts nothing. Built by `lab/cell.sh build` from `git archive` of a metabob-mcp commit, so the
# image is that commit's source and nothing uncommitted (docs/proposals/agent-cell-lab.md).
#
#   in:  the env file (METABOB_API_KEY, ANTHROPIC_API_KEY, DISCOVERY_ENDPOINT, CELL_ORIGIN), and /cell/fixture
#        (optional) copied into the created container
#   out: /out, copied out of the stopped container
FROM docker.io/oven/bun:1.3.14 AS bun

FROM docker.io/library/node:22-bookworm-slim
ARG CLAUDE_CODE_VERSION=2.1.280
ARG METABOB_REVISION=unknown
LABEL org.opencontainers.image.revision=$METABOB_REVISION org.opencontainers.image.title=metabob-agent-cell

RUN apt-get update \
 && apt-get install -y --no-install-recommends git ca-certificates python3 build-essential jq \
 && rm -rf /var/lib/apt/lists/*
COPY --from=bun /usr/local/bin/bun /usr/local/bin/bun
RUN npm install -g "@anthropic-ai/claude-code@${CLAUDE_CODE_VERSION}" && npm cache clean --force

# metabob-mcp at METABOB_REVISION, built as the npm package is.
COPY src/ /opt/metabob-mcp/
WORKDIR /opt/metabob-mcp
RUN bun install --frozen-lockfile && bun run build && node dist/cli.js --version

# The plugin as users install it, without its .mcp.json (which runs the published package): its skill and its edit
# check. The cell's own MCP config starts the server built above under the name the edit check matches, `metabob`.
RUN mkdir -p /opt/metabob-plugin \
 && cp -r plugin/.claude-plugin plugin/hooks plugin/scripts plugin/skills /opt/metabob-plugin/

COPY entrypoint.sh /usr/local/bin/cell-entrypoint
RUN chmod 755 /usr/local/bin/cell-entrypoint \
 && useradd -m -u 1001 cell \
 && mkdir -p /task /work /out /cell \
 && chown cell:cell /task /work /out /cell

USER cell
WORKDIR /work
ENTRYPOINT ["/usr/local/bin/cell-entrypoint"]
