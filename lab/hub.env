# hub.env: the lab hub's install inputs. No secrets here: the provider key is passed through from the environment of
# `lab.sh up`, and every other secret is generated by the image on first boot and kept in the lab-hub volumes.
SUBSTRATE_NAME=lab-hub
SUBSTRATE_PORT_PREFIX=24
# Host-side ports bind 127.0.0.1 only; nodes talk to each other on the lab network.
SUBSTRATE_PUBLISH_IP=127.0.0.1
PROFILE=hub
LAB_IP=10.89.77.10
# What /bootstrap advertises to joiners: the hub's lab-network address and its in-container ports, because joiners
# live on the lab network. The relay listens on container port 30333.
PUBLIC_IP=10.89.77.10
RELAY_ANNOUNCE_PORT=30333
DISCOVERY_PUBLIC_URL=http://10.89.77.10:8100
IDENTITY_PUBLIC_URL=http://10.89.77.10:8101
