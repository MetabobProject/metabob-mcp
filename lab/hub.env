# hub.env: the lab hub's install inputs. No secrets here: the provider key is passed through from the environment of
# `lab.sh up`, and every other secret is generated by the image on first boot and kept in the lab-hub volumes.
SUBSTRATE_NAME=lab-hub
SUBSTRATE_PORT_PREFIX=24
# Host-side ports bind 127.0.0.1 only; nodes talk to each other on the lab network.
SUBSTRATE_PUBLISH_IP=127.0.0.1
# hub-minimal: the hub's roles without autonomy or compute; goals run on the spoke.
PROFILE=hub-minimal
LAB_IP=10.89.77.10
# What /bootstrap advertises to joiners: the hub's lab-network address and its in-container ports, because joiners
# live on the lab network. The relay listens on container port 30333.
PUBLIC_IP=10.89.77.10
RELAY_ANNOUNCE_PORT=30333
DISCOVERY_PUBLIC_URL=http://10.89.77.10:8100
IDENTITY_PUBLIC_URL=http://10.89.77.10:8101
# Light lab: only what metabob-mcp touches (identity, discovery, concept-db, activity-api, llm-resolver) plus
# the infrastructure their readiness needs (surrealdb, valkey, seeders, substrate-ready, self-recovery). Masked at
# boot by the image's own inventory step, so the manifest stays unmodified.
DISABLED_VESSELS=autonomy-metrics.service,autonomy-metrics.timer,coherence-metric.service,coherence-metric.timer,coherence-recover.service,coherence-recover.timer,compose-drift.service,compose-drift.timer,db-contention-check.service,db-contention-check.timer,db-maintenance.service,db-maintenance.timer,development-vessel-seed.service,git-push-setup.service,joint-liveness.service,joint-liveness.timer,learning-loop-selftest.service,learning-loop-selftest.timer,light-dispatch-healthcheck.service,light-dispatch-healthcheck.timer,memory-budget-check.service,memory-budget-check.timer,model-reality-audit.service,model-reality-audit.timer,relevance-sink-vessel.service,self-development-trend.service,self-development-trend.timer,self-operational-health.service,self-operational-health.timer,self-repair-operational.service,self-repair-operational.timer,spectral-gap.service,spectral-gap.timer,substrate-pull-sync.service,substrate-pull-sync.timer,trace-store-health-check.service,trace-store-health-check.timer,validator-liveness.service,validator-liveness.timer
