# spoke.env: the lab spoke's install inputs. The join key is NOT here: `lab.sh up` issues it from the running hub into
# keys/lab-spoke.key (mode 0600) and passes it through the environment at launch.
SUBSTRATE_NAME=lab-spoke
SUBSTRATE_PORT_PREFIX=25
SUBSTRATE_PUBLISH_IP=127.0.0.1
LAB_IP=10.89.77.20
# The join anchor: the hub's discovery on the lab network. The image derives identity (8101) and the trace store
# (8080) from it, and learns the relay from the hub's /bootstrap.
DISCOVERY_ENDPOINT=http://10.89.77.10:8100
# Light lab: only what metabob-mcp touches (discovery, goal-host, local-tools for the deterministic shellResult
# satisfier) plus seeders, substrate-ready and self-recovery. Masked at boot by the image's own inventory step.
DISABLED_VESSELS=analysis-vessel.service,autonomy-metrics.service,autonomy-metrics.timer,boredom-vessel.service,boredom-vessel.timer,development-vessel-seed.service,development-vessel.service,gap-store-census.service,gap-store-census.timer,git-push-setup.service,learning-liveness-probe.service,learning-liveness-probe.timer,light-dispatch-healthcheck.service,light-dispatch-healthcheck.timer,light-dispatch-vessel.service,memory-budget-check.service,memory-budget-check.timer,obsidian-collaborate.service,obsidian-collaborate.timer,obsidian-intake.service,obsidian-intake.timer,obsidian-learn.service,obsidian-learn.timer,rhythm-cadence.service,rhythm-cadence.timer,ribosome-vessel.service,runtime-drift.service,runtime-drift.timer,self-development-trend.service,self-development-trend.timer,self-operational-health.service,self-operational-health.timer,self-repair-operational.service,self-repair-operational.timer,stateful-ui-vessel.service,substrate-pull-sync.service,substrate-pull-sync.timer
