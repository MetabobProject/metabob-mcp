# spoke.env: the lab spoke's install inputs. The join key is NOT here: `lab.sh up` issues it from the running hub into
# keys/lab-spoke.key (mode 0600) and passes it through the environment at launch.
SUBSTRATE_NAME=lab-spoke
SUBSTRATE_PORT_PREFIX=25
SUBSTRATE_PUBLISH_IP=127.0.0.1
LAB_IP=10.89.77.20
# The join anchor: the hub's discovery on the lab network. The image derives identity (8101) and the trace store
# (8080) from it, and learns the relay from the hub's /bootstrap.
DISCOVERY_ENDPOINT=http://10.89.77.10:8100
