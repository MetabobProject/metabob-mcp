{
  "mcpServers": {
    "metabob": {
      "command": "npx",
      "args": [
        "-y",
        "--package=metabob-mcp-server@npm:@metabob/mcp@0.4.0-rc.2",
        "metabob-mcp"
      ],
      "env": {
        "METABOB_API_KEY": "${user_config.api_key}",
        "DISCOVERY_ENDPOINT": "${user_config.discovery_endpoint}",
        "METABOB_ENDPOINT": "${user_config.endpoint}"
      }
    }
  }
}
