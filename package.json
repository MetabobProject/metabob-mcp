{
  "name": "@metabob/mcp",
  "version": "0.4.0-rc.3",
  "description": "Metabob MCP: a shared work ledger, code-structure tools and the substrate cockpit for AI agents",
  "type": "module",
  "bin": {
    "mcp": "dist/cli.js",
    "metabob-mcp": "dist/cli.js",
    "metabob-mcp-doctor": "dist/doctor-cli.js"
  },
  "files": [
    "dist/**/*",
    "skills/**/*",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "preflight": "bun run scripts/verify-vendor.ts",
    "start": "bun run preflight && bun run src/cli.ts",
    "dev": "bun run preflight && bun --watch src/cli.ts",
    "test": "bun run preflight && bun test --timeout 30000 tests",
    "typecheck": "bun run preflight && tsc --noEmit",
    "build": "bun run preflight && bun build src/cli.ts src/doctor-cli.ts --target node --splitting --outdir dist --external tree-sitter --external tree-sitter-javascript --external tree-sitter-python --external tree-sitter-typescript && bun run scripts/finalize-cli.ts",
    "prepublishOnly": "bun run typecheck && bun run build"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "metabob",
    "code-analysis",
    "ai-agent",
    "claude",
    "cursor",
    "code-property-graph",
    "cpg",
    "impact-analysis",
    "agent-coordination"
  ],
  "author": "Metabob Inc.",
  "license": "PROPRIETARY",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MetabobProject/metabob-mcp.git"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "engines": {
    "node": ">=18.0.0",
    "bun": ">=1.1.0"
  },
  "dependencies": {
    "tree-sitter": "^0.21.1",
    "tree-sitter-javascript": "^0.23.0",
    "tree-sitter-python": "^0.21.0",
    "tree-sitter-typescript": "^0.23.0"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "^1.0.4",
    "@types/bun": "latest",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "hono": "^4.0.0",
    "system-ca": "3.0.0",
    "typescript": "^5.3.0",
    "undici": "^6.21.0",
    "zod": "^3.23.8"
  },
  "trustedDependencies": [
    "tree-sitter",
    "tree-sitter-javascript",
    "tree-sitter-python",
    "tree-sitter-typescript"
  ]
}
