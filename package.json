{
  "name": "@metabob/mcp",
  "version": "0.2.7",
  "description": "MCP server exposing Metabob analysis capabilities to AI agents",
  "type": "module",
  "bin": {
    "metabob-mcp": "dist/cli.js"
  },
  "workspaces": [
    "vendor/cpg-inference"
  ],
  "files": [
    "dist/**/*",
    "include/**/*",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "start": "bun run src/index.ts",
    "dev": "bun --watch src/index.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "build:vendor": "(cd vendor/cpg-inference && bun run build)",
    "build:model": "mkdir -p include && cp vendor/cpg-inference/include/*.onnx vendor/cpg-inference/include/*.onnx.data include/",
    "build": "bun run build:vendor && bun run build:model && bun build src/cli.ts --target node --outdir dist --external onnxruntime-node --external tree-sitter --external tree-sitter-javascript --external tree-sitter-python --external tree-sitter-typescript --external usearch && chmod +x dist/cli.js",
    "validate:backend": "bun run scripts/validate-backend.ts",
    "prepublishOnly": "bun run typecheck && bun run build"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "metabob",
    "code-analysis",
    "ai-agent",
    "claude",
    "cursor",
    "code-property-graph",
    "cpg"
  ],
  "author": "Metabob Inc.",
  "license": "PROPRIETARY",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MetabobProject/metabob-mcp.git"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.4",
    "hono": "^4.0.0",
    "onnxruntime-node": "^1.20.1",
    "tree-sitter": "^0.21.1",
    "tree-sitter-javascript": "^0.23.0",
    "tree-sitter-python": "^0.21.0",
    "tree-sitter-typescript": "^0.23.0",
    "usearch": "^2.21.4",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^5.3.0"
  },
  "trustedDependencies": [
    "onnxruntime-node",
    "tree-sitter-javascript",
    "tree-sitter-python",
    "usearch"
  ]
}
