{
  "name": "@metabob/mcp",
  "version": "0.2.20",
  "description": "MCP server exposing Metabob analysis capabilities to AI agents",
  "type": "module",
  "bin": {
    "mcp": "dist/cli.js",
    "metabob-mcp": "dist/cli.js",
    "metabob-mcp-doctor": "dist/doctor-cli.js"
  },
  "files": [
    "dist/**/*",
    "include/**/*",
    "skills/**/*",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "preflight": "bun run scripts/verify-vendor.ts",
    "start": "bun run preflight && bun run src/cli.ts",
    "dev": "bun run preflight && bun --watch src/cli.ts",
    "test": "bun run preflight && bun test tests",
    "typecheck": "bun run preflight && tsc --noEmit",
    "build:model": "bun run preflight && bun run scripts/copy-model-assets.ts",
    "build": "bun run build:model && bun build src/cli.ts src/doctor-cli.ts --target node --outdir dist --external @avigopal/libp2p-federation-transport --external onnxruntime-node --external tree-sitter --external tree-sitter-javascript --external tree-sitter-python --external tree-sitter-typescript && bun run scripts/finalize-cli.ts",
    "validate:backend": "bun run scripts/validate-backend.ts",
    "prepublishOnly": "bun run typecheck && bun run build"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "metabob",
    "code-analysis",
    "ai-agent",
    "claude",
    "cursor",
    "code-property-graph",
    "cpg"
  ],
  "author": "Metabob Inc.",
  "license": "PROPRIETARY",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MetabobProject/metabob-mcp.git"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "engines": {
    "node": ">=18.0.0",
    "bun": ">=1.1.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.4",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "hono": "^4.0.0",
    "https-proxy-agent": "^7.0.0",
    "onnxruntime-node": "^1.20.1",
    "proxy-from-env": "^1.1.0",
    "system-ca": "3.0.0",
    "tree-sitter": "^0.21.1",
    "undici": "^6.21.0",
    "tree-sitter-javascript": "^0.23.0",
    "tree-sitter-python": "^0.21.0",
    "tree-sitter-typescript": "^0.23.0",
    "ws": "^8.18.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/proxy-from-env": "^1.0.4",
    "@types/ws": "^8.18.1",
    "typescript": "^5.3.0"
  },
  "trustedDependencies": [
    "onnxruntime-node",
    "tree-sitter",
    "tree-sitter-javascript",
    "tree-sitter-python",
    "tree-sitter-typescript"
  ],
  "peerDependencies": {
    "@avigopal/libp2p-federation-transport": "github:AviGopal/libp2p-federation-transport"
  },
  "peerDependenciesMeta": {
    "@avigopal/libp2p-federation-transport": {
      "optional": true
    }
  }
}
