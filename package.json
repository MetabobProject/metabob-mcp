{
  "name": "@metabob/mcp",
  "version": "0.2.0",
  "description": "MCP server exposing Metabob analysis capabilities to AI agents",
  "type": "module",
  "bin": {
    "metabob-mcp": "dist/cli.js"
  },
  "files": [
    "dist/**/*",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "start": "bun run src/index.ts",
    "dev": "bun --watch src/index.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "build": "bun build src/cli.ts --target node --outdir dist --external onnxruntime-node --external tree-sitter --external tree-sitter-javascript --external tree-sitter-python --external usearch && chmod +x dist/cli.js",
    "prepublishOnly": "bun run typecheck && bun run build"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "metabob",
    "code-analysis",
    "ai-agent",
    "claude",
    "cursor",
    "code-property-graph",
    "cpg"
  ],
  "author": "Metabob Inc.",
  "license": "PROPRIETARY",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MetabobProject/metabob-mcp.git"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "@metabob/cpg-inference": "file:../cpg-inference-ts",
    "@modelcontextprotocol/sdk": "^1.0.4",
    "hono": "^4.0.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^5.3.0"
  },
  "trustedDependencies": [
    "onnxruntime-node",
    "tree-sitter-javascript",
    "tree-sitter-python",
    "usearch"
  ]
}
